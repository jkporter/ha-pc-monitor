<Project Sdk="Microsoft.NET.Sdk">

  <!-- Cross-platform tests for the parts that do not need Windows: protocol decoding, HA payloads and MQTT publishing. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../src/HassHwStats/Core/Sensor.cs" Link="Linked/Sensor.cs" />
    <Compile Include="../../src/HassHwStats/Core/Slug.cs" Link="Linked/Slug.cs" />
    <Compile Include="../../src/HassHwStats/Core/Backoff.cs" Link="Linked/Backoff.cs" />
    <Compile Include="../../src/HassHwStats/Core/Options.cs" Link="Linked/Options.cs" />
    <Compile Include="../../src/HassHwStats/Core/DashboardWriter.cs" Link="Linked/DashboardWriter.cs" />
    <Compile Include="../../src/HassHwStats/Sources/WireViewProtocol.cs" Link="Linked/WireViewProtocol.cs" />
    <Compile Include="../../src/HassHwStats/Sources/HwinfoSharedMemory.cs" Link="Linked/HwinfoSharedMemory.cs" />
    <Compile Include="../../src/HassHwStats/Sources/WireViewEntities.cs" Link="Linked/WireViewEntities.cs" />
    <Compile Include="../../src/HassHwStats/Sources/WireViewSource.cs" Link="Linked/WireViewSource.cs" />
    <Compile Include="../../src/HassHwStats/Mqtt/HomeAssistantPayloads.cs" Link="Linked/HomeAssistantPayloads.cs" />
    <Compile Include="../../src/HassHwStats/Mqtt/MqttPublisher.cs" Link="Linked/MqttPublisher.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="MQTTnet" Version="5.2.0.1603" />
    <PackageReference Include="System.IO.Ports" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
  </ItemGroup>

</Project>
