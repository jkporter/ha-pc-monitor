{
  "NodeName": "",
  "IntervalMs": 2000,

  "Mqtt": {
    "Host": "homeassistant.local",
    "Port": 1883,
    "Username": "",
    "Password": "",
    "UseTls": false,
    "AllowUntrustedCertificate": false,
    "DiscoveryPrefix": "homeassistant",
    "BaseTopic": "hass-hw-stats"
  },

  "Hardware": {
    "Enabled": true,
    "Cpu": true,
    "Gpu": true,
    "Memory": true,
    "Motherboard": false,
    "Storage": false,
    "Network": false,
    "Mode": "Curated",
    "Include": [],
    "Exclude": []
  },

  "WireView": {
    "Enabled": true,
    "Source": "Auto",
    "Port": "",
    "PublishPins": true
  },

  "Rtss": {
    "Enabled": true
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  }
}
